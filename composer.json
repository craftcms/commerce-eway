{
  "name": "craftcms/commerce-eway",
  "description": "eWAY integration for Craft Commerce 6.0+",
  "type": "craft-plugin",
  "keywords": [
    "eway",
    "commerce",
    "craftcms"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/commerce-eway/issues?state=open",
    "source": "https://github.com/craftcms/commerce-eway",
    "docs": "https://github.com/craftcms/commerce-eway",
    "rss": "https://github.com/craftcms/commerce-eway/commits/5.x.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/commerce": "6.x-dev"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "larastan/larastan": "^3.4",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\CommerceEway\\": "src/",
      "craft\\commerce\\eway\\": "legacy/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\CommerceEway\\Tests\\": "tests/"
    }
  },
  "extra": {
    "name": "eWay for Craft Commerce",
    "handle": "commerce-eway",
    "developer": "Pixel & Tonic",
    "documentationUrl": "https://github.com/craftcms/commerce-eway/blob/5.x/README.md",
    "class": "CraftCms\\CommerceEway\\Plugin"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    }
  }
}
